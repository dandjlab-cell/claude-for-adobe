#!/bin/sh
# Refuse to push anything private to the public repo. Installed by scripts/install.sh (core.hooksPath).
# Git hooks get a minimal PATH; find node where Homebrew/nvm/Volta put it.
PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$PATH"; export PATH
cd "$(git rev-parse --show-toplevel)" || exit 1
NODE="$(command -v node)"; [ -n "$NODE" ] || { echo "pre-push: node not found; cannot run the privacy scan" >&2; exit 1; }
"$NODE" --test test/privacy.test.cjs >/dev/null 2>&1 || { echo "pre-push: private data found in tracked files. Run: node --test test/privacy.test.cjs" >&2; exit 1; }
